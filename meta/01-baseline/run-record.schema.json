{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oasis observed run record v1",
  "type": "object",
  "required": [
    "run_id",
    "objective_path",
    "role",
    "model",
    "assessed_on",
    "input_commit",
    "output_commit",
    "selected_action",
    "verification_result",
    "verification_links",
    "rework",
    "failures",
    "elapsed_seconds",
    "cost_usd",
    "input_tokens",
    "output_tokens",
    "modified_paths",
    "evidence_class"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "objective_path": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessed_on": {
      "type": "string"
    },
    "input_commit": {
      "type": "string"
    },
    "output_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_action": {
      "type": "string"
    },
    "verification_result": {
      "type": "string",
      "enum": [
        "not_run",
        "passed",
        "failed"
      ]
    },
    "verification_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rework": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "modified_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "planning",
        "source_inspection",
        "tested_behavior",
        "customer_evidence"
      ]
    }
  }
}
